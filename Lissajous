import numpy as np
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt
import matplotlib.animation as animation
import warnings
warnings.filterwarnings('ignore')

plt.rcParams['figure.facecolor'] = 'white'
plt.rcParams['axes.facecolor'] = 'white'

# ══════════════════════════════════════════════════════════════════
# SECCIÓN 1 – PARÁMETROS GLOBALES
# ══════════════════════════════════════════════════════════════════
N = 4

K_GAINS = np.array([1.0, 1.0])
KC = 1.0
T_END, DT_SAVE = 20.0, 0.05

# Curva de Lissajous abierta (ecuación 15 de la foto)
#   f1(w) = 2*sin(sqrt(2)*w)
#   f2(w) = sin(w)
# La razón a/b = sqrt(2)/1 = sqrt(2) ∈ ℝ\ℚ → curva NO periódica (abierta)
ALPHA = np.sqrt(2)   # frecuencia para f1
BETA  = 1.0          # frecuencia para f2

# Diferencia paramétrica deseada entre agentes adyacentes (figura 15)
# No depende de ningún período T porque la curva es abierta.
DELTA = np.pi / 10    # Δ_ij = π/6

COLORS = ['#E63946', '#2A9D8F', '#E9C46A', '#A663CC']
LABELS = [f'Agente {i+1}' for i in range(N)]

# ══════════════════════════════════════════════════════════════════
# SECCIÓN 2 – FUNCIONES DE LA CURVA
# ══════════════════════════════════════════════════════════════════
def f(w):
    return np.array([
        2.0 * np.sin(ALPHA * w),
        np.sin(BETA  * w)
    ])

def df(w):
    return np.array([
        2.0 * ALPHA * np.cos(ALPHA * w),
        BETA        * np.cos(BETA  * w)
    ])

# ══════════════════════════════════════════════════════════════════
# SECCIÓN 3 – TOPOLOGÍA DE COMUNICACIÓN
# ══════════════════════════════════════════════════════════════════
# Cadena lineal: agente i se comunica con i-1 e i+1.
# El agente 0 y el agente N-1 NO se comunican entre sí
# (la curva es abierta/no periódica → no hay identificación de extremos).
NEIGHBORS = {}
for i in range(N):
    nbrs = []
    if i > 0:
        nbrs.append(i - 1)      # vecino izquierdo (si existe)
    if i < N - 1:
        nbrs.append(i + 1)      # vecino derecho (si existe)
    NEIGHBORS[i] = nbrs

# Configuración de referencia: los agentes arrancan separados por DELTA
# en el parámetro virtual. No se usa ningún período T.
W_STAR = np.array([i * DELTA for i in range(N)])

# Diferencias deseadas: Δ_ij = W_STAR[i] - W_STAR[j]
# (positivo si i > j, negativo si i < j)

# ══════════════════════════════════════════════════════════════════
# SECCIÓN 4 – DINÁMICA ODE
# ══════════════════════════════════════════════════════════════════
def ode_rhs(t, state):
    """
    Estado: [x1, y1, w1, x2, y2, w2, ..., xN, yN, wN]
    Para cada agente i:
        dx_i  = f'(w_i) - K*(x_i - f(w_i))          [seguimiento]
        dw_i  = 1 + K*(x_i - f(w_i))·f'(w_i) + kc*c_i  [coordinación]
    con c_i = -Σ_{j∈N_i} (w_i - w_j - Δ_ij)
    y Δ_ij = W_STAR[i] - W_STAR[j]  (diferencia paramétrica deseada).
    """
    dstate = np.zeros_like(state)
    w_all  = state[2::3]

    for i in range(N):
        idx = i * 3
        xi  = state[idx:idx+2]
        wi  = state[idx+2]

        fi  = f(wi)
        dfi = df(wi)

        phi_err = xi - fi                            # error de seguimiento

        dx = dfi - K_GAINS * phi_err                # ẋ_i
        dw = 1.0 + np.dot(K_GAINS * phi_err, dfi)  # ẇ_i (parte path-following)

        # Componente de coordinación: suma sobre vecinos en cadena lineal
        ci = 0.0
        for j in NEIGHBORS[i]:
            delta_ij = W_STAR[i] - W_STAR[j]       # diferencia paramétrica deseada
            ci -= (w_all[i] - w_all[j] - delta_ij)

        dstate[idx:idx+3] = np.concatenate([dx, [dw + KC * ci]])

    return dstate

# ══════════════════════════════════════════════════════════════════
# SECCIÓN 5 – VISUALIZACIÓN
# ══════════════════════════════════════════════════════════════════
def style_ax(ax, title, xlabel, ylabel):
    ax.set_facecolor('white')
    ax.set_title(title, color='black', fontsize=14, pad=12)
    ax.set_xlabel(xlabel, color='black', fontsize=12)
    ax.set_ylabel(ylabel, color='black', fontsize=12)
    ax.tick_params(colors='black', labelsize=8)
    for spine in ax.spines.values():
        spine.set_color('black')
    ax.grid(True, color='lightgray', linewidth=0.5)
    return ax

ani = None

def plot_results(sol, pf_errors, coord_errors, pairs):
    global ani

    X_LIM = (-4, 4)
    Y_LIM = (-3, 3)

    # ── 1. ANIMACIÓN ──────────────────────────────────────────────
    fig_anim, ax_anim = plt.subplots(figsize=(7, 5), facecolor='white')
    style_ax(ax_anim,
             'Animación – Curva de Lissajous abierta (cadena lineal)',
             'x₁ (m)', 'x₂ (m)')
    ax_anim.set_aspect('equal')

    trails = [ax_anim.plot([], [], '-',
                           color=COLORS[i % len(COLORS)], lw=1.5, alpha=0.7)[0]
              for i in range(N)]
    heads  = [ax_anim.plot([], [], 'o',
                           color=COLORS[i % len(COLORS)], ms=6, mec='black',
                           label=LABELS[i])[0]
              for i in range(N)]
    ax_anim.set_xlim(*X_LIM)
    ax_anim.set_ylim(*Y_LIM)
    ax_anim.legend(loc='upper right', fontsize=8)

    def update(frame):
        for i in range(N):
            x_hist = sol.y[i*3,     :frame+1]
            y_hist = sol.y[i*3 + 1, :frame+1]
            trails[i].set_data(x_hist, y_hist)
            heads[i].set_data([x_hist[-1]], [y_hist[-1]])
        return trails + heads

    ani = animation.FuncAnimation(
        fig_anim, update, frames=len(sol.t), interval=15, blit=True)

    # ── 2. ERROR DE SEGUIMIENTO ───────────────────────────────────
    fig2, ax_pf = plt.subplots(figsize=(7, 4), facecolor='white')
    style_ax(ax_pf,
             'Error de seguimiento',
             'Tiempo (s)', r'Error $\|\Phi_i(\xi_i)\|$ (m)')
    for i in range(N):
        ax_pf.plot(sol.t, pf_errors[i],
                   color=COLORS[i % len(COLORS)], label=LABELS[i])
    ax_pf.legend(fontsize=8)

    # ── 3. ESTADO FINAL ───────────────────────────────────────────
    fig3, ax_final = plt.subplots(figsize=(8, 5), facecolor='white')
    style_ax(ax_final, 'Estado final del sistema (t=20s)',
             'x₁ (m)', 'x₂ (m)')
    ax_final.set_aspect('equal')
    for i in range(N):
        ax_final.plot(sol.y[i*3, :], sol.y[i*3+1, :],
                      color=COLORS[i % len(COLORS)], lw=1, alpha=0.6)
        xf, yf = sol.y[i*3, -1], sol.y[i*3+1, -1]
        ax_final.plot(xf, yf, 'o',
                      color=COLORS[i % len(COLORS)], ms=8, mec='black',
                      label=LABELS[i])
    ax_final.set_xlim(*X_LIM)
    ax_final.set_ylim(*Y_LIM)
    ax_final.legend(fontsize=8)

    # ── 4. ERROR DE COORDINACIÓN ──────────────────────────────────
    fig4, ax_co = plt.subplots(figsize=(7, 4), facecolor='white')
    style_ax(ax_co,
             'Error de coordinación',
             'Tiempo (s)',
             'Error angular (rad)')
    for idx, (i, j) in enumerate(pairs):
        ax_co.plot(sol.t, coord_errors[idx],
                   label=f'Agente {i+1}-Agente {j+1}', lw=1.2)
    ax_co.axhline(0, color='black', ls='--', alpha=0.3)
    ax_co.legend(fontsize=8)

    plt.tight_layout()
    plt.show()

# ══════════════════════════════════════════════════════════════════
# EJECUCIÓN
# ══════════════════════════════════════════════════════════════════
if __name__ == "__main__":
    print(f"Simulación: N={N} agentes, curva abierta, cadena lineal")
    print(f"  Δ_ij = π/6 ≈ {DELTA:.4f} rad  (diferencia paramétrica fija)")
    print(f"  Agentes sin comunicar: 0 ↔ {N-1}  (extremos de la cadena)\n")

    rng = np.random.default_rng(7)
    s0  = np.zeros(N * 3)
    for i in range(N):
        s0[i*3:i*3+2] = rng.uniform([-4, -3], [4, 3])  # posición inicial en rango de ejes
        s0[i*3+2]     = W_STAR[i]                # parámetro virtual en referencia

    t_eval = np.arange(0.0, T_END + DT_SAVE, DT_SAVE)

    sol = solve_ivp(
        ode_rhs, (0.0, T_END), s0,
        t_eval=t_eval, method='RK45',
        rtol=1e-6, atol=1e-8
    )

    # Errores de seguimiento
    nt     = len(sol.t)
    pf_err = np.zeros((N, nt))
    for k in range(nt):
        for i in range(N):
            pf_err[i, k] = np.linalg.norm(
                sol.y[i*3:i*3+2, k] - f(sol.y[i*3+2, k])
            )

    # Errores de coordinación: solo pares de vecinos en la cadena
    pairs  = [(i, i+1) for i in range(N-1)]   # cadena: (0,1),(1,2),(2,3)
    co_err = np.zeros((len(pairs), nt))
    for k in range(nt):
        w_all = sol.y[2::3, k]
        for idx, (i, j) in enumerate(pairs):
            delta_ij      = W_STAR[i] - W_STAR[j]
            co_err[idx, k] = w_all[i] - w_all[j] - delta_ij

    print(f"Error de seguimiento final (medio): "
          f"{pf_err[:, -1].mean():.4f} m")
    print(f"Error de coordinación final (medio): "
          f"{np.abs(co_err[:, -1]).mean():.4f} rad")

    plot_results(sol, pf_err, co_err, pairs)
