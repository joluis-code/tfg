import numpy as np
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt
import matplotlib.animation as animation
from mpl_toolkits.mplot3d import Axes3D
import matplotlib.cm as cm
import warnings
warnings.filterwarnings('ignore')

# Fondo blanco global
plt.rcParams['figure.facecolor'] = 'white'
plt.rcParams['axes.facecolor'] = 'white'

# ══════════════════════════════════════════════════════════════════
# SECCIÓN 1 – PARÁMETROS GLOBALES
# ══════════════════════════════════════════════════════════════════
N, T = 15, 2 * np.pi
K_GAINS = np.array([1, 1, 1])
KC = 100
T_END, DT_SAVE = 10.0, 0.05

COLORS = [cm.hsv(i / N) for i in range(N)]
LABELS = [f'Agente {i+1}' for i in range(N)]

# ══════════════════════════════════════════════════════════════════
# SECCIÓN 2 – CURVA PARAMÉTRICA 3D
# ══════════════════════════════════════════════════════════════════
def f(w):
    x1 = 15 * np.sin(2 * w)
    x2 = 30 * np.sin(w) * np.sqrt(np.clip(0.5 * (1 - 0.5 * np.sin(w)**2), 0, None))
    x3 = 5 + 5 * np.cos(2 * w) - 2
    return np.array([x1, x2, x3])

def df(w):
    eps = 1e-6
    return (f(w + eps) - f(w - eps)) / (2 * eps)

NEIGHBORS = {i: [(i - 1) % N, (i + 1) % N] for i in range(N)}
W_STAR = np.array([i * T / N for i in range(N)])

# ══════════════════════════════════════════════════════════════════
# SECCIÓN 3 – DINÁMICA Y ODE
# ══════════════════════════════════════════════════════════════════
def ode_rhs(t, state):
    dstate = np.zeros_like(state)
    w_all = state[3::4]
    for i in range(N):
        idx = i * 4
        xi = state[idx:idx+3]
        wi = state[idx+3]

        fi  = f(wi)
        dfi = df(wi)

        phi_err = xi - fi
        dx  = dfi - K_GAINS * phi_err
        dw  = 1.0 + np.dot(K_GAINS * phi_err, dfi)

        ci = 0.0
        for j in NEIGHBORS[i]:
            ci -= (w_all[i] - w_all[j] - (W_STAR[i] - W_STAR[j]))

        dstate[idx:idx+4] = np.concatenate([dx, [dw + KC * ci]])
    return dstate

# ══════════════════════════════════════════════════════════════════
# SECCIÓN 4 – VISUALIZACIÓN
# ══════════════════════════════════════════════════════════════════
def style_ax(ax, title, xlabel, ylabel):
    ax.set_facecolor('white')
    ax.set_title(title, color='black', fontsize=14, pad=10)
    ax.set_xlabel(xlabel, color='black', fontsize=12)
    ax.set_ylabel(ylabel, color='black', fontsize=12)
    ax.tick_params(colors='black', labelsize=8)
    for spine in ax.spines.values():
        spine.set_color('black')
    ax.grid(True, color='lightgray', linewidth=0.5)
    return ax

def style_ax3d(ax, title):
    ax.set_facecolor('white')
    ax.xaxis.pane.fill = False
    ax.yaxis.pane.fill = False
    ax.zaxis.pane.fill = False
    ax.xaxis.pane.set_edgecolor('black')
    ax.yaxis.pane.set_edgecolor('black')
    ax.zaxis.pane.set_edgecolor('black')
    ax.set_title(title, color='black', fontsize=14)
    ax.tick_params(colors='black', labelsize=7)
    ax.set_xlabel('x₁ (m)', color='black', fontsize=12)
    ax.set_ylabel('x₂ (m)', color='black', fontsize=12)
    ax.set_zlabel('x₃ (m)', color='black', fontsize=12)

ani = None

def plot_results(sol, pf_errors, coord_errors, pairs):
    global ani

    w_ref = np.linspace(0, 2 * np.pi, 800)
    curve_pts = np.array([f(w) for w in w_ref])

    # 1. ESTADO FINAL
    fig1 = plt.figure(figsize=(10, 8), facecolor='white')
    ax1 = fig1.add_subplot(111, projection='3d')
    style_ax3d(ax1, 'Estado final del sistema')

    ax1.plot(curve_pts[:, 0], curve_pts[:, 1], curve_pts[:, 2],
             '-', color='#58a6ff', alpha=0.35, lw=2.0)

    for i in range(N):
        ax1.plot(sol.y[i*4, :], sol.y[i*4+1, :], sol.y[i*4+2, :],
                 color=COLORS[i], lw=0.5, alpha=0.3)
        xf = sol.y[i*4, -1]; yf = sol.y[i*4+1, -1]; zf = sol.y[i*4+2, -1]
        ax1.scatter(xf, yf, zf, color=COLORS[i], s=30,
                    edgecolors='black', linewidths=0.4, zorder=5)

    # 2. ANIMACIÓN
    fig_anim = plt.figure(figsize=(9, 8), facecolor='white')
    ax_anim = fig_anim.add_subplot(111, projection='3d')
    style_ax3d(ax_anim, 'Animación de la evolución del sistema')

    ax_anim.plot(curve_pts[:, 0], curve_pts[:, 1], curve_pts[:, 2],
                 '--', color='#58a6ff', alpha=0.3, lw=1.2)

    all_x = sol.y[0::4, :]; all_y = sol.y[1::4, :]; all_z = sol.y[2::4, :]
    pad = 3
    ax_anim.set_xlim(all_x.min()-pad, all_x.max()+pad)
    ax_anim.set_ylim(all_y.min()-pad, all_y.max()+pad)
    ax_anim.set_zlim(all_z.min()-pad, all_z.max()+pad)

    heads = [ax_anim.plot([], [], [], 'o', color=COLORS[i], ms=4,
                           markeredgecolor='black', markeredgewidth=0.3)[0]
             for i in range(N)]

    trails = [ax_anim.plot([], [], [], '-', color=COLORS[i], lw=0.8, alpha=0.4)[0]
              for i in range(10)]

    step = max(1, len(sol.t) // 200)
    frames_idx = list(range(0, len(sol.t), step))

    def update(frame):
        idx = frames_idx[frame]
        for i in range(N):
            xh = sol.y[i*4, idx]; yh = sol.y[i*4+1, idx]; zh = sol.y[i*4+2, idx]
            heads[i].set_data([xh], [yh]); heads[i].set_3d_properties([zh])
        for i in range(10):
            xtr = sol.y[i*4, :idx+1]
            ytr = sol.y[i*4+1, :idx+1]
            ztr = sol.y[i*4+2, :idx+1]
            trails[i].set_data(xtr, ytr); trails[i].set_3d_properties(ztr)
        return heads + trails

    ani = animation.FuncAnimation(fig_anim, update, frames=len(frames_idx),
                                   interval=30, blit=False)

    # 3. ERROR PATH-FOLLOWING
    fig3, axes_pf = plt.subplots(1, 2, figsize=(13, 4), facecolor='white')

    ax_all = axes_pf[0]
    style_ax(ax_all, 'Error de seguimiento',
             'Tiempo (s)', r'Error ‖$\Phi_k(\xi_k)$‖ (m)')
    for i in range(N):
        ax_all.plot(sol.t, pf_errors[i], color=COLORS[i], lw=0.6, alpha=0.6)

    ax_stat = axes_pf[1]
    style_ax(ax_stat, 'Error de seguimiento: estadísticas',
             'Tiempo (s)', r'Error ‖$\Phi_k(\xi_k)$‖ (m)')
    mean_pf = pf_errors.mean(axis=0)
    std_pf  = pf_errors.std(axis=0)
    ax_stat.plot(sol.t, mean_pf, color='#58a6ff', lw=1.5,label='Media')
    ax_stat.fill_between(sol.t, mean_pf - std_pf, mean_pf + std_pf,
                         color='#58a6ff', alpha=0.2, label='±1 std')
    ax_stat.plot(sol.t, pf_errors.max(axis=0), color='#E63946', lw=0.8, ls='--', label='Máximo')
    ax_stat.plot(sol.t, pf_errors.min(axis=0), color='#2A9D8F', lw=0.8, ls='--', label='Mínimo')
    ax_stat.legend(fontsize=9)

    fig3.tight_layout()

    # 4. ERROR DE COORDINACIÓN
    fig4, axes_co = plt.subplots(1, 2, figsize=(13, 4), facecolor='white')

    ax_co_all = axes_co[0]
    style_ax(ax_co_all, 'Error de coordinación',
             'Tiempo (s)', 'Error angular (rad)')
    for idx_p, (i, j) in enumerate(pairs):
        ax_co_all.plot(sol.t, coord_errors[idx_p],
                       color=COLORS[idx_p], lw=0.5, alpha=0.5)
    ax_co_all.axhline(0, color='black', ls='--', alpha=0.3)

    ax_co_stat = axes_co[1]
    style_ax(ax_co_stat, 'Error de coordinación: estadísticas',
             'Tiempo (s)', 'Error angular (rad)')
    mean_co = coord_errors.mean(axis=0)
    std_co  = coord_errors.std(axis=0)
    ax_co_stat.plot(sol.t, mean_co, color='#E9C46A', lw=1.5, label='Media')
    ax_co_stat.fill_between(sol.t, mean_co - std_co, mean_co + std_co,
                            color='#E9C46A', alpha=0.2, label='±1 std')
    ax_co_stat.plot(sol.t, np.abs(coord_errors).max(axis=0),
                    color='#E63946', lw=0.8, ls='--', label='Máximo')
    ax_co_stat.axhline(0, color='black', ls='--', alpha=0.3)
    ax_co_stat.legend(fontsize=9)

    fig4.tight_layout()

    plt.show()

# ══════════════════════════════════════════════════════════════════
# EJECUCIÓN
# ══════════════════════════════════════════════════════════════════
if __name__ == "__main__":
    print(f"Simulando trayectorias 3D con {N} agentes...")
    rng = np.random.default_rng(7)
    s0 = np.zeros(N * 4)
    for i in range(N):
        s0[i*4:i*4+3] = rng.uniform(-20, 20, 3)
        s0[i*4+3]     = W_STAR[i]

    t_eval = np.arange(0.0, T_END + DT_SAVE, DT_SAVE)

    sol = solve_ivp(ode_rhs, (0.0, T_END), s0, t_eval=t_eval, method='RK45',
                    rtol=1e-6, atol=1e-8)

    nt = len(sol.t)
    pf_err = np.zeros((N, nt))
    for k in range(nt):
        for i in range(N):
            pf_err[i, k] = np.linalg.norm(
                sol.y[i*4:i*4+3, k] - f(sol.y[i*4+3, k])
            )

    pairs  = [(i, (i+1) % N) for i in range(N)]
    co_err = np.zeros((len(pairs), nt))
    for k in range(nt):
        w_all = sol.y[3::4, k]
        for idx, (i, j) in enumerate(pairs):
            co_err[idx, k] = w_all[i] - w_all[j] - (W_STAR[i] - W_STAR[j])

    plot_results(sol, pf_err, co_err, pairs)
